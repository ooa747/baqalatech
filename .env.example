# انسخ هذا الملف إلى .env وغيّر القيم
PORT=8787
# مفتاح سري يستخدمه الـ crawler للكتابة — لازم يكون نفسه في crawler/.env
API_TOKEN=change-me-to-a-long-random-string
# النطاق المسموح له يقرأ من المتصفح (ضع رابط التطبيق عند النشر، مثلاً https://baqalatech.example)
CORS_ORIGIN=*
DB_PATH=./data/prices.db
